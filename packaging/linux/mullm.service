[Unit]
Description=muLLM — Local-first LLM Router
Documentation=https://github.com/mybrainrunslinux/mullm/blob/main/docs/DEPLOYMENT.md
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
Environment=MULLM_ENV_FILE=%h/.config/mullm/mullm.env
EnvironmentFile=-%h/.config/mullm/mullm.env
Environment=PATH=%h/.local/bin:%h/.mullm/bin:%h/.mullm1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env mullm-server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mullm

# harden slightly — not full sandbox, needs network + GPU
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
